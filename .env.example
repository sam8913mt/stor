# Copy to `.env` for local development (`cp .env.example .env`). `.env` is git-ignored.
#
# These two values are PUBLIC by design: they are compiled into the website and visible to every visitor.
# Your data is protected by the database's Row Level Security, not by hiding these.
#   Supabase dashboard → Project Settings → API → "Project URL" and "anon public" key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# NEVER put any of these in this file, in GitHub Pages, or anywhere in the frontend:
#   service_role key · database password · Stripe/Zarinpal/email provider keys · CRON_SECRET
# They belong only in Supabase Edge Function secrets (see EXTERNAL_SETUP.md). (Only exception: the optional keep-alive workflow keeps a copy of CRON_SECRET as the GitHub Actions secret KEEP_ALIVE_SECRET.)
